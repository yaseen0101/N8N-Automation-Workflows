    {
      "parameters": {
        "jsCode": "// In n8n, your input items will automatically come in as \"items\"\nconst data = items.map(i => i.json); // get all input JSON objects\n\n// Check if there is data\nif (!data || data.length === 0) {\n  return [{ json: { error: \"No data found\" } }];\n}\n\n// Loop dynamically over each supplier\nconst messages = data.map(vendor => {\n  const message = `\n📦 *Purchase Request*\n\nDear *${vendor.supplierName}*,\n\n📦 براہِ کرم درج ذیل اشیاء ہمارے گودام بھیج دیں۔\n\n🏠 پتہ: انٹرلیس روڈ، آئی-8 مرکز، اسلام آباد\n\nPlease deliver the following items to our branch:\n\n• *${vendor.item}* — *${vendor.shortage} units*\n\nWe are facing shortages and request prompt delivery.\n\nThank you,  \n*Warehouse Department*  \n*Business Name*\n`;\n\n  return {\n    json: {\n      to: `${vendor.contactNumber}`,\n      message: message.trim()\n    }\n  };\n});\n\n// Return the message list to the next node (WhatsApp node)\nreturn messages;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        96
      ],
      "id": "6b2493fd-386b-4a43-9272-38f971545e8b",
      "name": "Number & Msg For Item Vendor"
    },
    {
      "parameters": {
        "jsCode": "// Get all incoming data\nconst data = items.map(x => x.json);\n\n// Separate short items and supplier data\nconst shortItems = data.filter(d => d.item && d.shortage !== undefined);\nconst suppliers = data.filter(d => d[\"Item Supplied\"]);\n\n// Match each short item with its supplier\nconst result = shortItems.map(shortItem => {\n  const match = suppliers.find(supplier => \n    supplier[\"Item Supplied\"].toLowerCase().trim() === shortItem.item.toLowerCase().trim()\n  );\n\n  if (match) {\n    return {\n      item: shortItem.item,\n      inventoryQty: shortItem.inventoryQty,\n      thresholdQty: shortItem.thresholdQty,\n      shortage: shortItem.shortage,\n      supplierName: match[\"Supplier Name\"],\n      contactNumber: match[\"Contact Number\"],\n      email: match[\"Email\"],\n      unitPrice: match[\"Unit Price\"]\n    };\n  } else {\n    return {\n      item: shortItem.item,\n      inventoryQty: shortItem.inventoryQty,\n      thresholdQty: shortItem.thresholdQty,\n      shortage: shortItem.shortage,\n      supplierName: \"Not Found\",\n      contactNumber: \"N/A\",\n      email: \"N/A\",\n      unitPrice: \"N/A\"\n    };\n  }\n});\n\n// Return merged result as output\nreturn result.map(r => ({ json: r }));\n"
      },
