    {
      "parameters": {
        "jsCode": "// Input: Merged data from both sheets\n// Input 1 → Inventory Sheet\n// Input 2 → Threshold Sheet\n\n// Get data from both inputs\nconst inventoryData = items.filter(i => i.json.item).map(i => i.json);\nconst thresholdData = items.filter(i => i.json.Items).map(i => i.json);\n\n// Combine duplicate items in inventory (sum their quantities)\nconst inventoryTotals = {};\nfor (const entry of inventoryData) {\n  const name = entry.item.trim();\n  const qty = Number(entry.quantity) || 0;\n  inventoryTotals[name] = (inventoryTotals[name] || 0) + qty;\n}\n\n// Combine duplicate items in threshold (use max or latest value)\nconst thresholdTotals = {};\nfor (const entry of thresholdData) {\n  const name = entry.Items.trim();\n  const qty = Number(entry.Quantity) || 0;\n  // if same item appears multiple times, keep highest threshold\n  thresholdTotals[name] = Math.max(thresholdTotals[name] || 0, qty);\n}\n\n// Compare\nconst lowStockItems = [];\nfor (const [item, thresholdQty] of Object.entries(thresholdTotals)) {\n  const inventoryQty = inventoryTotals[item] || 0;\n  if (inventoryQty < thresholdQty) {\n    lowStockItems.push({\n      item,\n      inventoryQty,\n      thresholdQty,\n      shortage: thresholdQty - inventoryQty\n    });\n  }\n}\n\n// Return the result to next node\nreturn lowStockItems.map(i => ({ json: i }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        672
      ],
      "id": "48e1ef29-d923-4488-9b57-c867f92f5c0f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Format the inventory shortage data into a WhatsApp-friendly message\n\nconst shortages = items.map(i => i.json);\n// Build message header\nlet message = `📦 *Inventory Shortage Alert*\\n\\nThe following items are below the required threshold:\\n\\n`;\n\n// Add each item in a new line\nshortages.forEach(s => {\n  message += `🔹 *${s.item}*\\n   - In Stock: ${s.inventoryQty}\\n   - Short by: ${s.shortage}\\n\\n`;\n});\n\n// Add a footer\nmessage += `⚠️ Please reorder these items to maintain stock levels.\\n\\n~ Automated from Cobani Re-Order System`;\n\nreturn [{ json: { message } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
