      "parameters": {
        "functionCode": "// Try to get the chat text from common keys\nconst input =\n    $json.chatInput;\n\n// If input is empty, throw an error so we know\nif (!input) {\n    throw new Error(\"No chat message found. Check Chat Trigger output keys.\");\n}\n\n// Split into parts and trim spaces\nconst [item, quantity, date, price, supplier] = input.split(\",\").map(s => s.trim());\n\n// Return as object for Google Sheets\nreturn [\n    {\n        json: {\n            Item: item,\n            Quantity: quantity,\n            Date: date,\n            Price: price,\n            Supplier: supplier\n        }\n    }\n];"
      },
