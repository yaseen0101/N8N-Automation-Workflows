      ],
      "webhookId": "eee2d0cb-f03a-490d-a5b4-fa31c3edae24"
    },
    {
      "parameters": {
        "functionCode": "\n                // Parse incoming WhatsApp message into structured fields\n                const msg = $json[\"body\"] || $json[\"message\"] || \"\";\n                const parts = msg.split(\",\").map(p => p.trim());\n                let data = {};\n                if (parts.length >= 6) {\n                  data.Item = parts[0];\n                  data.Quantity = parseInt(parts[1]) || 0;\n                  data.Date = parts[2];\n                  data.Price = parts[3];\n                  data.Supplier = parts[4];\n                  const last = parts[5].toLowerCase();\n                  if (last === \"arrived\") {\n                    data.Action = \"Arrived\";\n                  } else if ([\"i8\", \"dha\"].includes(last)) {\n                    data.Action = \"Transfer\";\n                    data.Branch = last.toUpperCase();\n                  }\n                }\n                return [{json: data}];\n                "
      },
      "id": "ec89329b-9c34-486e-b113-0878ab3fb403",
      "name": "Parse WhatsApp Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -256,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"Action\"]}}",
