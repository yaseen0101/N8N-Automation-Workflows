    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => {\n  let body = item.json.body;\n\n  // 🧹 Step 1: Try to parse the body if it’s a JSON string\n  try {\n    if (typeof body === 'string') {\n      body = JSON.parse(body);\n    }\n  } catch (err) {\n    // If parsing fails, keep original body\n  }\n\n  // 🧩 Step 2: Handle if body is an array (Recipe Type)\n  if (Array.isArray(body)) {\n    const results = body.map(entry => ({\n      type: 'Recipe',\n      menuItem: entry.menuItem || 'N/A',\n      ingredient: entry.ingredient || 'N/A',\n      quantityUsed: entry.quantityUsed || 0,\n      unit: entry.unit || 'N/A',\n      timestamp: entry.timestamp || new Date().toISOString(),\n    }));\n    return results;\n  }\n\n  // 🧩 Step 3: Handle if body has an 'ingredients' key (Recipe container format)\n  if (body.ingredients && Array.isArray(body.ingredients)) {\n    const results = body.ingredients.map(entry => ({\n      Type: 'Recipe',\n      menuItem: body.menuItem || entry.menuItem || 'N/A',\n      ingredient: entry.ingredient || 'N/A',\n      quantityUsed: entry.quantityUsed || 0,\n      unit: entry.unit || 'N/A',\n      timestamp: body.timestamp || new Date().toISOString(),\n    }));\n    return results;\n  }\n\n  // 🧩 Step 4: Handle standard Inventory structure\n  // Clean and transform the date\n  let formattedDate;\n  if (body.date) {\n    const cleanDate = body.date.replace(/(st|nd|rd|th)/, '');\n    try {\n      const parsedDate = new Date(cleanDate);\n      formattedDate = isNaN(parsedDate)\n        ? new Date().toISOString().split('T')[0]\n        : parsedDate.toISOString().split('T')[0];\n    } catch {\n      formattedDate = new Date().toISOString().split('T')[0];\n    }\n  } else {\n    formattedDate = new Date().toISOString().split('T')[0];\n  }\n\n  // Process quantity to separate numeric value and unit\n  let quantityValue = 0;\n  let unitValue = 'N/A';\n  if (body.quantity) {\n    const quantityMatch = body.quantity.trim().match(/(\\d+)\\s*([a-zA-Z]+)/);\n    if (quantityMatch) {\n      quantityValue = parseInt(quantityMatch[1], 10) || 0;\n      unitValue = quantityMatch[2] || 'N/A';\n    } else {\n      quantityValue = parseInt(body.quantity.trim(), 10) || 0;\n    }\n  }\n\n  // 🧩 Step 5: Return Inventory object\n  return {\n    type: 'Inventory',\n    mode: body.mode || 'N/A',\n    location: body.location || 'N/A',\n    item: body.item || 'N/A',\n    quantity: quantityValue,\n    price: body.price ? parseFloat(body.price.replace('PKR', '').trim()) : 0,\n    date: formattedDate,\n    supplier: body.supplier || 'N/A',\n    branch: body.branch || 'Null',\n    unit: unitValue,\n    invoiceNumber: body.invoiceNumber || 'N/A',\n  };\n});\n\n// 🧹 Step 6: Flatten any nested arrays (from recipes)\nreturn items.flat();\n"
      },
