      "parameters": {
        "jsCode": "const items = $input.all().map(item => {\n  const body = item.json.body; // Access the webhook body\n\n  // Clean and transform the date\n  let formattedDate;\n  if (body.date) {\n    // Remove ordinal suffixes (st, nd, rd, th) from the date string\n    const cleanDate = body.date.replace(/(st|nd|rd|th)/, '');\n    try {\n      const parsedDate = new Date(cleanDate);\n      formattedDate = isNaN(parsedDate) ? new Date().toISOString().split('T')[0] : parsedDate.toISOString().split('T')[0];\n    } catch (error) {\n      formattedDate = new Date().toISOString().split('T')[0];\n    }\n  } else {\n    // Use current date if date is missing\n    formattedDate = new Date().toISOString().split('T')[0];\n  }\n\n  // Clean and transform the rest of the data\n  return {\n    mode: body.mode || 'N/A', // Default to 'N/A' if missing\n    location: body.location || 'N/A',\n    item: body.item || 'N/A',\n    quantity: body.quantity || '0', // Default to '0' if missing\n    price: body.price ? parseFloat(body.price.replace('PKR', '').trim()) : 0, // Remove 'PKR' and convert to number\n    date: formattedDate, // Use the processed date\n    supplier: body.supplier || 'N/A',\n    branch: body.branch || 'Null' // Add branch, default to 'Null' if missing\n  };\n});\n\n// Return the processed items\nreturn items;"
      },
