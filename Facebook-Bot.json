    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called googleDriveLink to the JSON of each one\nfor (let item of $input.all()) {\n    // Extract the Google Drive link using a simple string search\n    let text = item.json.output || \"\"; // Safely access the output field, default to empty string if not found\n    let startIdx = text.indexOf(\"https://drive.google.com/file/d/\");\n    if (startIdx !== -1) {\n        let endIdx = text.indexOf(\"/view?usp=sharing\", startIdx) + \"/view?usp=sharing\".length;\n        // Ensure endIdx is within bounds, otherwise use the end of the string\n        if (endIdx > text.length || endIdx < 0) {\n            endIdx = text.length;\n        }\n        let googleDriveLink = text.substring(startIdx, endIdx);\n        item.json.googleDriveLink = googleDriveLink;\n    } else {\n        item.json.googleDriveLink = null;\n    }\n    // Add the original output as a separate field\n    item.json.outputText = text;\n}\nreturn $input.all(); // Return the modified items"
      },
